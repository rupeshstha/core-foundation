{
    "name": "rupeshstha/core-foundation",
    "description": "A foundational package for streamlined development, offering essential core functionality and components to accelerate project creation and enhance scalability.",
    "keywords": [
        "laravel",
        "core-foundation",
        "api",
        "modular-monolith",
        "starter-kit",
        "dto",
        "repository-pattern",
        "octane",
        "rupeshstha"
    ],
    "homepage": "https://github.com/rupeshstha/core-foundation",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Rupesh Shrestha",
            "email": "rupesh@thartisansfoundry.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.3|^8.4",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/slack-notification-channel": "^3.8",
        "symfony/stopwatch": "^7.0 | ^8.0"
    },
    "suggest": {
        "laravel/pennant": "Required for BaseFeature and FeatureFlagController (GET /features).",
        "dedoc/scramble": "Required for automatic OpenAPI doc generation. CoreFoundationServiceProvider auto-registers envelope and exception extensions when installed."
    },
    "require-dev": {
        "laravel/boost": "^2.4",
        "laravel/pennant": "^1.23",
        "laravel/pint": "^1.29",
        "nikic/php-parser": "^5.7",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.6",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "CoreFoundation\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreFoundation\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:lint": "vendor/bin/pint --test",
        "test:types": "vendor/bin/phpstan analyse --verbose --memory-limit=512M",
        "test:unit": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "email": "contact@rupeshstha.com.np",
        "issues": "https://github.com/rupeshstha/core-foundation/issues",
        "source": "https://github.com/rupeshstha/core-foundation",
        "docs": "https://rupesh-shrestha.gitbook.io/core-foundation/"
    },
    "extra": {
        "laravel": {
            "providers": [
                "CoreFoundation\\Providers\\CoreFoundationServiceProvider"
            ],
            "aliases": {
                "ServerTiming": "CoreFoundation\\Facades\\ServerTiming"
            }
        }
    }
}
