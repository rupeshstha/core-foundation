{
    "name": "rupeshstha/core-foundation",
    "description": "A foundational package for streamlined development, offering essential core functionality and components to accelerate project creation and enhance scalability.",
    "keywords": [
        "rupeshstha",
        "core-foundation"
    ],
    "homepage": "https://github.com/rupeshstha/core-foundation",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Rupesh Shrestha",
            "email": "rupesh@thartisansfoundry.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.3|^8.4",
        "composer/class-map-generator": "^1.7",
        "illuminate/database": "*",
        "illuminate/support": "*",
        "laravel/slack-notification-channel": "^3.8"
    },
     "require-dev": {
        "symfony/stopwatch": "^8.0",
        "laravel/boost": "^1.8",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^8.37",
        "pestphp/pest": "^2.36",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "CoreFoundation\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreFoundation\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "email": "contact@rupeshstha.com.np",
        "issues":"https://github.com/rupeshstha/core-foundation/issues",
        "source":"https://github.com/rupeshstha/core-foundation",
        "docs": "https://rupesh-shrestha.gitbook.io/core-foundation/"
      },
    "extra": {
        "laravel": {
            "providers": [
                "CoreFoundation\\Providers\\CoreFoundationServiceProvider"
            ],
            "aliases": {

            }
        }
    }
}
