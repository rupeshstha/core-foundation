<?php

namespace {{ namespace }}\Http\Controllers;

use Throwable;
use Illuminate\Http\JsonResponse;
use CoreFoundation\Http\Controllers\BaseController;
use {{ namespace }}\Services\{{ class }}Service;
use {{ namespace }}\Http\Requests\Store{{ class }}Request;
use {{ namespace }}\Http\Requests\Update{{ class }}Request;
use {{ namespace }}\Resources\{{ class }}Resource;

class {{ class }}Controller extends BaseController
{
    public function __construct(
        private readonly {{ class }}Service $service,
    ) {}

    public function index(): JsonResponse
    {
        try {
            ${{ modelVariable }} = $this->service->fetchAll();
        } catch (Throwable $exception) {
            return $this->handleException($exception);
        }

        return $this->paginatedResponse(
            paginator: ${{ modelVariable }},
            message: $this->lang('fetch-all-success'),
        );
    }

    public function show(int $id): JsonResponse
    {
        try {
            ${{ modelVariable }} = $this->service->fetchById($id);
        } catch (Throwable $exception) {
            return $this->handleException($exception);
        }

        return $this->successResponse(
            message: $this->lang('fetch-success'),
            payload: new {{ class }}Resource(${{ modelVariable }}),
        );
    }

    public function store(Store{{ class }}Request $request): JsonResponse
    {
        try {
            $result = $this->service->create($request->validated());
        } catch (Throwable $exception) {
            return $this->handleException($exception);
        }

        return $this->createdResponse(
            message: $this->lang('create-success'),
            payload: new {{ class }}Resource($result),
        );
    }

    public function update(Update{{ class }}Request $request, int $id): JsonResponse
    {
        try {
            $result = $this->service->update($id, $request->validated());
        } catch (Throwable $exception) {
            return $this->handleException($exception);
        }

        return $this->successResponse(
            message: $this->lang('update-success'),
            payload: new {{ class }}Resource($result),
        );
    }

    public function destroy(int $id): JsonResponse
    {
        try {
            $this->service->delete($id);
        } catch (Throwable $exception) {
            return $this->handleException($exception);
        }

        return $this->noContentResponse();
    }
}
